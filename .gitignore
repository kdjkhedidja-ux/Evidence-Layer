# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# Generated artifacts (regenerate with scripts/build_dataset.py)
data/dev/*.jsonl
data/test/*.jsonl

# Generated extension splits (regenerate with scripts/build_extension_dataset.py)
data/extension_dev/*.jsonl
data/extension_test/*.jsonl

# Generated real-world benchmark splits (regenerate with scripts/verify_real_world_benchmark.py)
data/real_world_dev/*.jsonl
data/real_world_validation/*.jsonl
data/real_world_test/*.jsonl

# Private blind-review mappings and coordinator-only review records
data/real_world/review-private/

# Phase 2 evaluation reports (regenerate with scripts/run_evaluation.py)
reports/
!reports/
reports/*
!reports/phase6_real_world_lexical.json
!reports/phase6_real_world_jev.json
!reports/phase6_real_world_jev_manifest.json

# Environment files (templates stay tracked)
.env
.env.*
!.env.example

# Supabase CLI local link metadata (may contain connection details)
supabase/.temp/

# Supabase CLI local state
supabase/.branches/
