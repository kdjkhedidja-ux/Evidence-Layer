FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY services/snapshot-verifier/snapshot_verifier_service ./snapshot_verifier_service
RUN python -m pip install --no-cache-dir '.[service]'

USER 10001:10001

CMD ["python", "-m", "snapshot_verifier_service.worker"]
