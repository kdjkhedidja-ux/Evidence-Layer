{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evidence-recovery-fence-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "RECOVERY_STATE", "class_name": "RecoveryState" },
      { "name": "LEDGER_STATE", "class_name": "LedgerState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RecoveryState"] },
    { "tag": "v2", "new_sqlite_classes": ["LedgerState"] }
  ]
}
