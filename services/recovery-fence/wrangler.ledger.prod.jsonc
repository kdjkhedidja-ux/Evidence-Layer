{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evidence-recovery-ledger-prod",
  "main": "src/ledger-worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER_STATE", "class_name": "LedgerState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LedgerState"] }
  ]
}
