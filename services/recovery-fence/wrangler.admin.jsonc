{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evidence-recovery-admin-test",
  "main": "src/admin-worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "RECOVERY_STATE", "class_name": "RecoveryState", "script_name": "evidence-recovery-fence-test" }
    ]
  },
  "services": [
    { "binding": "EVENT_LEDGER", "service": "evidence-recovery-ledger-test" }
  ]
}
