FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY services/evidence-service/requirements-worker.txt ./requirements-worker.txt
COPY src ./src
COPY services/evidence-service/evidence_service ./evidence_service
RUN python -m pip install --no-cache-dir '.[service]' -r requirements-worker.txt

USER 10001:10001

CMD ["python", "-m", "evidence_service.deletion_worker"]
