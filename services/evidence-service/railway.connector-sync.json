{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/evidence-service/Dockerfile.connector-worker"
  },
  "deploy": {
    "startCommand": "python -m evidence_service.connector_sync_worker",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
