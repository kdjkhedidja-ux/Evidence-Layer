# Dedicated account-deletion worker. Never commit values.
# The continuous worker uses DATABASE_URL and passes its privileged connection
# to the purge and Storage-cleanup slices.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DELETION_WORKER_INTERVAL_SECONDS=60

# The one-shot purge_worker / account_deletion_worker CLI path uses this
# dedicated URL instead of DATABASE_URL.
EVIDENCE_PURGE_DATABASE_URL=

# Optional separate credential for the read-only deletion health check cron.
DELETION_HEALTHCHECK_DATABASE_URL=
DELETION_PURGE_PENDING_WARN_MINUTES=10
DELETION_ACCEPTED_WARN_MINUTES=10
DELETION_QUEUE_WARN_MINUTES=30
